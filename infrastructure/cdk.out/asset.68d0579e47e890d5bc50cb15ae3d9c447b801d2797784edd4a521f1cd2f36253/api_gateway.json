{
  "apiName": "CostGuardAPI",
  "description": "REST API for CostGuard cost management and automated prevention system",
  "apiType": "REST",
  "endpointConfiguration": {
    "types": ["REGIONAL"]
  },
  "routes": [
    {
      "path": "/api/fetch",
      "method": "POST",
      "description": "Fetch and store cost data from Cost Explorer",
      "phase": "1",
      "integration": {
        "type": "AWS_PROXY",
        "httpMethod": "POST",
        "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/${LAMBDA_ARN}/invocations"
      },
      "requirements": ["Phase 1"]
    },
    {
      "path": "/api/cost-data",
      "method": "GET",
      "description": "Query stored cost data",
      "phase": "1",
      "integration": {
        "type": "AWS_PROXY",
        "httpMethod": "POST",
        "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/${LAMBDA_ARN}/invocations"
      },
      "requirements": ["Phase 1"]
    },
    {
      "path": "/api/cost-estimation/current",
      "method": "GET",
      "description": "Get current cost estimates for all services",
      "phase": "1.5",
      "integration": {
        "type": "AWS_PROXY",
        "httpMethod": "POST",
        "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/${LAMBDA_ARN}/invocations"
      },
      "requirements": ["Phase 1.5"]
    },
    {
      "path": "/api/cost-estimation/service/{service}",
      "method": "GET",
      "description": "Get current cost estimate for specific service",
      "phase": "1.5",
      "pathParameters": ["service"],
      "integration": {
        "type": "AWS_PROXY",
        "httpMethod": "POST",
        "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/${LAMBDA_ARN}/invocations"
      },
      "requirements": ["Phase 1.5"]
    },
    {
      "path": "/api/cost-forecast",
      "method": "GET",
      "description": "Get AI-powered cost forecast for all services",
      "phase": "2",
      "queryParameters": ["days", "granularity"],
      "integration": {
        "type": "AWS_PROXY",
        "httpMethod": "POST",
        "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/${LAMBDA_ARN}/invocations"
      },
      "requirements": ["Phase 2"]
    },
    {
      "path": "/api/cost-forecast/service/{service}",
      "method": "GET",
      "description": "Get AI-powered cost forecast for specific service",
      "phase": "2",
      "pathParameters": ["service"],
      "queryParameters": ["days", "granularity"],
      "integration": {
        "type": "AWS_PROXY",
        "httpMethod": "POST",
        "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/${LAMBDA_ARN}/invocations"
      },
      "requirements": ["Phase 2"]
    },
    {
      "path": "/api/prevention/status",
      "method": "GET",
      "description": "Get prevention system status",
      "phase": "3",
      "integration": {
        "type": "AWS_PROXY",
        "httpMethod": "POST",
        "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/${LAMBDA_ARN}/invocations"
      },
      "requirements": ["10.1"]
    },
    {
      "path": "/api/prevention/enable",
      "method": "POST",
      "description": "Enable prevention system",
      "phase": "3",
      "integration": {
        "type": "AWS_PROXY",
        "httpMethod": "POST",
        "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/${LAMBDA_ARN}/invocations"
      },
      "requirements": ["10.2"]
    },
    {
      "path": "/api/prevention/disable",
      "method": "POST",
      "description": "Disable prevention system",
      "phase": "3",
      "integration": {
        "type": "AWS_PROXY",
        "httpMethod": "POST",
        "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/${LAMBDA_ARN}/invocations"
      },
      "requirements": ["10.3"]
    },
    {
      "path": "/api/prevention/resources",
      "method": "GET",
      "description": "Get discovered resource inventory",
      "phase": "3",
      "queryParameters": ["service", "state", "limit"],
      "integration": {
        "type": "AWS_PROXY",
        "httpMethod": "POST",
        "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/${LAMBDA_ARN}/invocations"
      },
      "requirements": ["10.4"]
    },
    {
      "path": "/api/prevention/rollback",
      "method": "POST",
      "description": "Rollback a prevention action",
      "phase": "3",
      "integration": {
        "type": "AWS_PROXY",
        "httpMethod": "POST",
        "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/${LAMBDA_ARN}/invocations"
      },
      "requirements": ["10.5"]
    },
    {
      "path": "/api/prevention/history",
      "method": "GET",
      "description": "Get prevention action history",
      "phase": "3",
      "queryParameters": ["start_date", "end_date", "limit"],
      "integration": {
        "type": "AWS_PROXY",
        "httpMethod": "POST",
        "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/${LAMBDA_ARN}/invocations"
      },
      "requirements": ["10.6"]
    }
  ],
  "cors": {
    "enabled": true,
    "allowOrigins": ["*"],
    "allowMethods": ["GET", "POST", "OPTIONS"],
    "allowHeaders": ["Content-Type", "X-Amz-Date", "Authorization", "X-Api-Key", "X-Amz-Security-Token"],
    "maxAge": 300
  },
  "stages": [
    {
      "name": "dev",
      "description": "Development stage",
      "variables": {
        "environment": "development"
      }
    },
    {
      "name": "prod",
      "description": "Production stage",
      "variables": {
        "environment": "production"
      },
      "throttling": {
        "rateLimit": 1000,
        "burstLimit": 2000
      }
    }
  ],
  "authentication": {
    "type": "API_KEY",
    "note": "API key authentication recommended for production deployment"
  },
  "backwardCompatibility": {
    "note": "All Phase 1, 1.5, and 2 routes remain unchanged",
    "requirements": ["15.1", "15.2", "15.3", "15.4", "15.5"]
  },
  "notes": [
    "All routes use AWS_PROXY integration with the same Lambda function",
    "CORS is enabled for all origins (restrict in production)",
    "API Gateway is within free tier: 1M API calls/month",
    "Throttling limits are set for production stage only",
    "All Phase 3 routes are additive - no breaking changes to existing routes",
    "Path parameters use {parameter} syntax",
    "Query parameters are passed through to Lambda"
  ]
}
